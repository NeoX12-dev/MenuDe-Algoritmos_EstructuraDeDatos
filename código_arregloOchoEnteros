#include <iostream>
using namespace std;

int main() {
    int arreglo[8] = {7, 2, 9, 1, 5, 8, 3, 6};
    int aux;

    // Paso 2: Ordenar el arreglo con método burbuja
    for (int i = 0; i < 7; i++) {
        for (int j = 0; j < 7 - i; j++) {
            if (arreglo[j] > arreglo[j + 1]) {
                aux = arreglo[j];
                arreglo[j] = arreglo[j + 1];
                arreglo[j + 1] = aux;
            }
        }
    }

    // Paso 3: Imprimir el arreglo ordenado
    cout << "Arreglo ordenado:" << endl;
    for (int i = 0; i < 8; i++) {
        cout << arreglo[i] << " ";
    }
    cout << endl;

    return 0;
}
